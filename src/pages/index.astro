<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="apple-touch-icon" href="/logo.png" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <!-- ── Core SEO Meta Tags ──────────────────────────────────────── -->
  <title>Salsabila | AI Full-Stack Developer & Software Engineer</title>
  <meta name="title" content="Salsabila | AI Full-Stack Developer & Software Engineer" />
  <meta name="description" content="Salsabila is an AI Full-Stack Developer specializing in React, Next.js, FastAPI, Node.js, and applied AI systems. View portfolio, real-world multi-branch projects, and case studies." />
  <meta name="keywords" content="Salsabila, Salsabila developer, AI Full-Stack Developer, Full Stack Developer, React Developer, Next.js, FastAPI, Python, Machine Learning, UNIKOM, Portfolio Salsabila" />
  <meta name="author" content="Salsabila" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="theme-color" content="#d86c8c" />
  <link rel="canonical" href={Astro.url.href} />

  <!-- ── Open Graph / Facebook / LinkedIn ────────────────────────── -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:title" content="Salsabila | AI Full-Stack Developer & Software Engineer" />
  <meta property="og:description" content="Portfolio of Salsabila — building scalable full-stack applications and applied AI systems across 3 brands and 20+ branches." />
  <meta property="og:image" content="/avatar.jpeg" />
  <meta property="og:image:alt" content="Salsabila - AI Full-Stack Developer" />
  <meta property="og:site_name" content="Salsabila Portfolio" />
  <meta property="og:locale" content="en_US" />

  <!-- ── Twitter Card ───────────────────────────────────────────── -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={Astro.url.href} />
  <meta name="twitter:title" content="Salsabila | AI Full-Stack Developer & Software Engineer" />
  <meta name="twitter:description" content="Portfolio of Salsabila — building scalable full-stack applications and applied AI systems across 3 brands and 20+ branches." />
  <meta name="twitter:image" content="/avatar.jpeg" />

  <!-- ── JSON-LD Structured Data (Schema.org) for Google Search ──── -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "#person",
        "name": "Salsabila",
        "jobTitle": "AI Full-Stack Developer",
        "description": "Informatics Engineering student and AI Full-Stack Developer building web applications and applied AI systems.",
        "image": "/avatar.jpeg",
        "url": Astro.url.href,
        "sameAs": [
          "https://github.com/salsabl22",
          "https://www.linkedin.com/in/salsabilatech/"
        ],
        "knowsAbout": [
          "Full-Stack Development",
          "Artificial Intelligence",
          "React",
          "Next.js",
          "FastAPI",
          "Python",
          "TypeScript",
          "Machine Learning",
          "NLP",
          "Computer Vision"
        ],
        "alumniOf": {
          "@type": "EducationalOrganization",
          "name": "Universitas Komputer Indonesia"
        }
      },
      {
        "@type": "WebSite",
        "@id": "#website",
        "url": Astro.url.href,
        "name": "Salsabila | Portfolio",
        "description": "Official portfolio of Salsabila - AI Full-Stack Developer",
        "publisher": {
          "@id": "#person"
        }
      }
    ]
  })} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>
<body>

  <!-- ── Splash Screen / Intro Animation (1.5s Total) ───────── -->
  <div id="splash-screen" aria-hidden="true">
    <div class="splash-content">
      <!-- Flying Paper Plane with Sparkling Star Trail -->
      <div class="paper-plane-wrapper" id="splash-plane">
        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="filter: drop-shadow(0 0 12px var(--accent-2));">
          <path d="M22 2L11 13"/>
          <path d="M22 2l-7 20-4-9-9-4 20-7z"/>
        </svg>
      </div>

      <!-- Sparkle Trail Container -->
      <div class="splash-stars-trail" id="splash-trail"></div>

      <!-- Salsabila Brand Reveal -->
      <div class="splash-title">Salsabila.</div>
    </div>
  </div>

  <!-- ── Slower Sparkle Cursor Dot ───────────────────────────── -->
  <div id="cursor-dot" aria-hidden="true"></div>

  <!-- ── Navigation ────────────────────────────────────────── -->
  <header class="nav" role="banner">
    <div class="nav-inner">
      <a href="#hero" class="nav-logo" aria-label="Back to top">Salsabila.</a>

      <nav aria-label="Main navigation">
        <ul class="nav-links">
          <li><a href="#about"      class="nav-link">About</a></li>
          <li><a href="#experience" class="nav-link">Experience</a></li>
          <li><a href="#projects"   class="nav-link">Projects</a></li>
          <li><a href="#techstack"  class="nav-link">Tech Stack</a></li>
          <li><a href="#education"  class="nav-link">Education</a></li>
          <li><a href="#contact"    class="nav-link">Contact</a></li>
        </ul>
      </nav>

      <div style="display:flex;align-items:center;gap:0.75rem;">
        <button id="theme-toggle" class="theme-btn" aria-label="Toggle dark/light mode">
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="hidden" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
          </svg>
        </button>
        <a href="#contact" class="btn btn-primary" style="display:none;" id="hire-btn">Let's Talk</a>
      </div>
    </div>
  </header>

  <!-- ── Hero Section ──────────────────────────────────────── -->
  <section id="hero" class="section" style="padding-top:7.5rem;padding-bottom:4.5rem;" aria-label="Introduction">
    <!-- Ambient Glow Backgrounds -->
    <div aria-hidden="true" class="animate-pulse-slow" style="position:absolute;top:10%;right:10%;width:340px;height:340px;border-radius:50%;background:var(--accent);opacity:0.08;filter:blur(80px);pointer-events:none;"></div>
    <div aria-hidden="true" class="animate-pulse-slow" style="position:absolute;bottom:15%;left:8%;width:280px;height:280px;border-radius:50%;background:var(--accent-2);opacity:0.1;filter:blur(70px);pointer-events:none;"></div>

    <div class="container">
      <div class="hero-wrapper">

        <!-- Text Column -->
        <div class="hero-text-col">
          <div class="fade-up">
            <span class="section-label">AI Full-Stack Developer</span>
          </div>

          <h1 class="fade-up" style="font-size:clamp(2.4rem,4.5vw,3.8rem);font-weight:700;color:var(--text);margin-top:0.75rem;margin-bottom:0.75rem;transition-delay:0.08s;line-height:1.15;">
            Hi, I'm <span style="color:var(--accent);font-style:italic;">Salsabila</span>
          </h1>

          <!-- Mobile Avatar: Visible ONLY on mobile & tablet, placed right below "Hi, I'm Salsabila" and above the description -->
          <div class="hero-avatar-mobile fade-up" style="transition-delay:0.12s;">
            <div class="avatar-wrap">
              <img
                src="/avatar.jpeg"
                alt="Salsabila — Full-Stack Developer & AI Engineer"
                class="avatar-img"
                width="200"
                height="200"
                loading="eager"
              />
            </div>
          </div>

          <p class="fade-up" style="font-size:1.05rem;color:var(--text-2);max-width:540px;line-height:1.75;margin-bottom:1.75rem;transition-delay:0.14s;">
            I build <strong style="color:var(--accent);font-weight:600;">AI-powered full-stack systems</strong> that turn manual, multi-branch operations into one scalable platform, shipped across 3 brands and 20+ branches.
          </p>

          <!-- Stats -->
          <div class="fade-up card hero-stats" style="transition-delay:0.2s;" aria-label="Key statistics">
            <div class="hero-stat-item">
              <div class="stat-num" style="font-family:'Playfair Display',serif;font-weight:700;color:var(--accent);line-height:1;">20+</div>
              <div class="stat-lbl" style="color:var(--text-3);margin-top:0.25rem;font-weight:500;">Branches Scaled</div>
            </div>
            <div class="hero-stat-divider" style="width:1px;background:var(--border);"></div>
            <div class="hero-stat-item">
              <div class="stat-num" style="font-family:'Playfair Display',serif;font-weight:700;color:var(--accent);line-height:1;">3</div>
              <div class="stat-lbl" style="color:var(--text-3);margin-top:0.25rem;font-weight:500;">Brands Digitized</div>
            </div>
            <div class="hero-stat-divider" style="width:1px;background:var(--border);"></div>
            <div class="hero-stat-item">
              <div class="stat-num" style="font-family:'Playfair Display',serif;font-weight:700;color:var(--accent);line-height:1;">6+</div>
              <div class="stat-lbl" style="color:var(--text-3);margin-top:0.25rem;font-weight:500;">Projects Shipped</div>
            </div>
          </div>

          <div class="fade-up" style="display:flex;flex-wrap:wrap;gap:0.85rem;transition-delay:0.26s;">
            <a href="#projects" class="btn btn-primary">Explore Projects</a>
            <a href="#experience" class="btn btn-outline">View Experience</a>
          </div>
        </div>

        <!-- Desktop Avatar: Visible ONLY on Laptop & Desktop (placed side-by-side) -->
        <div class="hero-avatar-col hero-avatar-desktop fade-up" style="transition-delay:0.12s;">
          <div class="avatar-wrap">
            <img
              src="/avatar.jpeg"
              alt="Salsabila — Full-Stack Developer & AI Engineer"
              class="avatar-img"
              width="250"
              height="250"
              loading="eager"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── About ─────────────────────────────────────────────── -->
  <section id="about" class="section section-alt" aria-labelledby="about-title">
    <div class="container">
      <div style="max-width:860px;margin:0 auto;">
        <div style="text-align:center;">
          <span class="section-label fade-up">About Me</span>
          <h2 id="about-title" class="section-title fade-up" style="transition-delay:0.06s;">Software Built for Real-World Operations</h2>
          <p class="section-sub fade-up" style="margin-left:auto;margin-right:auto;transition-delay:0.1s;">Full-stack developer with applied AI skills, turning complex workflows into clean, reliable products.</p>
        </div>

        <div class="card fade-up" style="padding:2rem;margin-bottom:1.75rem;transition-delay:0.14s;">
          <p style="color:var(--text-2);font-size:0.98rem;line-height:1.8;margin-bottom:1.15rem;">
            I’m an Informatics Engineering student and a full-stack developer who builds web applications and AI-powered systems. During my internship, I developed a stock opname and warehouse management system that lets admins manage inventory and sales across 20+ branches of 3 brands in a single platform.
          </p>
          <p style="color:var(--text-2);font-size:0.98rem;line-height:1.8;">
            I build full-stack products with React, Next.js, TypeScript, and Tailwind on the front end, and Laravel, Flask, Node.js, and Prisma over MySQL on the back end. Beyond the web layer, I work with applied AI, including NLP with IndoBERT and Scikit-learn, computer vision with OpenCV, and deep learning with TensorFlow. I integrate these models directly into web apps so they solve a real workflow instead of sitting on the side. As a writer in English and Indonesian, I also turn complex problems into clear documentation and ideas teams can act on.
          </p>
        </div>

        <!-- 4 Grid Info Cards -->
