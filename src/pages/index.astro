/* ── 3 Experiences (each with 3 preview images that auto-slide) ────────── */
const experiences = [
  {
    id: "exp-1",
    role: "AI Full-Stack Developer Cohort",
    company: "Asah led by Dicoding Supported by GOTO",
    period: "August 2026 — present",
    description: "Built a capstone solution to digitize Indonesian MSMEs (UMKM), turning real business problems into a working full-stack, AI-integrated application. Completed 10+ certified courses spanning frontend, backend, databases, and AI integration. Strengthened teamwork, communication, and problem-solving through intensive project-based collaboration.",
    tags: ["Next.js", "FastAPI", "MySQL", "Vite", "TailwindCSS", "GitHub", "Problem Solving", "Collaboration", "Teamwork"],
    images: ["/asah-1.jpeg", "/asah-2.jpeg", "/asah-3.jpeg", "/asah-4.jpeg"],
    imageAlt: "AI Full-Stack Developer Cohort at Asah led by Dicoding Supported by GOTO",
  },
  {
    id: "exp-2",
    role: "Full-Stack Developer Intern",
    company: "CV Bujangan Wajib Sejahtera",
    period: "August 2026 — October 2026",
    description: "Warehouse teams across 3 brands and 20+ branches needed one reliable view of inventory and sales. I built a full-stack stock opname and warehouse management system with React, Node.js/Express, Prisma, and MySQL, featuring 15+ frontend modules, role-based access, and a scalable backend. The dashboards and report export now streamline inventory monitoring, and the brand-specific, plain-language interface keeps the system easy for non-technical staff.",
    tags: ["React", "Node.js", "Express", "Prisma", "MySQL", "Problem Solving", "Communication", "Attention to Detail"],
    images: ["/fotosnaps-1.png", "/fotosnaps-2.png", "/fotosnaps-3.jpeg", "/fotosnaps-4.jpeg",],
    imageAlt: "Full-Stack Developer Intern at CV Bujangan Wajib Sejahtera",
  },
  {
    id: "exp-3",
    role: "Independent Writer",
    company: "Self-Employed",
    period: "December 2024 — present",
    description: "Everyday details and abstract ideas often go unnoticed because they are hard to put into words. I turn them into accessible reflective essays in English and Indonesian at Medium @salsabila_, across topics from technology to education and society. My essay The Art of Noticing the Unnoticed reached 2.4K+ views on TikTok @writtenbysal_, strengthening my storytelling, research, and critical thinking.",
    tags: ["Creative Writing", "Critical Thinking", "Storytelling"],
    images: ["/writing-1.png", "/writing-4.png", "/writing-5.png"],
    imageAlt: "Independent Writer",
  },
  {
    id: "exp-4",
    role: "Member",
    company: "UNIKOM CodeLabs",
    period: "February 2024 — January 2025",
    description: "I joined UNIKOM CodeLabs to turn technical skills into solutions that hold up in competition. I competed in national-level data and technology competitions, built website projects with my team, and contributed Business Model Canvas strategies. I also presented our ideas as a speaker and stayed current through weekly technical discussions, which strengthened my analytics, problem-solving, and public speaking skills.",
    tags: ["Competition", "Teamwork", "Communication", "Public Speaking", "Data Analytics"],
    images: ["/codelabs-1.jpeg", "/codelabs-2.jpeg", "/codelabs-3.jpeg", "/codelabs-4.jpeg"],
    imageAlt: "Member at UNIKOM CodeLabs",
  },
];

/* ── Projects (each with 3 preview images that auto-slide) ─────────────── */
const projects = [
  {
    id: "proj-1",
    title: "Multi-Brand Stock Opname & Warehouse System",
    description: "Warehouse teams across 3 brands needed one reliable way to manage inventory and sales across 10+ branches. I built a full-stack stock opname and warehouse management system that brings it all into a single platform, with role-based access for 3+ user roles. Stock and sales dashboards with report export now streamline inventory monitoring, and a brand-specific interface with simplified language keeps it easy for non-technical staff.",
    tags: ["React", "Node.js", "MySQL", "Prisma", "REST API"],
    status: "Production",
    images: ["/projek1.png", "/projek2.png", "/projek3.png", "/projek4.png"],
    demoLink: "https://jawarastokopname.onrender.com/",
    githubLink: "https://github.com/salsabl22/stokopname",
  },
  {
    id: "proj-2",
    title: "Pojok Religi | AI Chatbot",
    description: "Questions about religion, spirituality, and everyday moral life are hard to explore with clear, structured guidance. I built a multi-faith AI assistant with Flask and Groq’s LLaMA 3.3 70B that answers them in organized, thoughtful responses, and reads uploaded PDF, DOCX, JPG, and PNG files through LLaMA 4 Scout vision. Per-user chat history, light and dark themes, and a responsive, mobile-friendly interface make it easy to use on any device.",
    tags: ["Python", "Flask", "Groq API", "LLaMA 3.3", "JavaScript"],
    status: "AI Project",
    images: ["/projek5.png", "/projek6.png"],
    demoLink: "https://pojok-religi.vercel.app/",
    githubLink: "https://github.com/salsabl22/pojok_religi",
  },
  {
    id: "proj-3",
    title: "Gestura | BISINDO Hand Sign Recognition",
    description: "Indonesian Sign Language (BISINDO) has few accessible digital tools to bridge communication between deaf and hearing people. I built Gestura, a real-time recognition system that tracks hand landmarks with MediaPipe and OpenCV, then turns gestures into on-screen text and Indonesian speech. It combines rule-based recognition for all 26 alphabet letters, a Random Forest classifier trained on a custom dataset, and custom word gestures, plus a built-in tool for collecting data and training new models.",
    tags: ["Python", "MediaPipe", "OpenCV", "Scikit-learn", "Random Forest", "Text-to-Speech"],
    status: "Computer Vision Project",
    images: ["/projek7.png", "/projek8.png"],
    githubLink: "https://github.com/salsabl22/gestura",
  },
  {
    id: "proj-4",
    title: "Pixeltify | Spotify Receipt Generator",
    description: "Music stats are usually buried in settings or a once-a-year recap. I built Pixeltify, a web app that connects to the Spotify Web API and turns your top tracks into a shareable pixel-art receipt. It wraps API integration and OAuth authentication in a playful, personalized interface, with downloadable results you can post anywhere.",
    tags: ["React", "TypeScript", "Tailwind CSS", "Spotify Web API", "OAuth"],
    status: "Web App",
    images: ["/projek9.jpg", "/projek10.jpg", "/projek11.jpg"],
    githubLink: "https://github.com/Edwin-Jaya/Pixelated-Receiptify",
  },
  {
    id: "proj-5",
    title: "Expense Tracker App",
    description: "Tracking personal income and expenses often means spreadsheets or apps that require an account. I built a lightweight expense tracker in vanilla JavaScript with no frameworks and no backend: it shows a live balance in Rupiah, separates income and expense lists, and supports instant search, in-place editing, and one-click type switching. Everything, including a custom date picker built from scratch, runs in the browser, and data persists through localStorage.",
    tags: ["JavaScript (ES6+)", "HTML5", "CSS3", "Responsive Design", "localStorage"],
    status: "Front-End Project",
    images: ["/projek12.png", "/projek13.png"],
    demoLink: "https://expense-tracker-app-phi-kohl.vercel.app/",
    githubLink: "https://github.com/salsabl22/expense-tracker-app",
  },
  {
    id: "proj-6",
    title: "Personal Notes App",
    description: "Note-taking apps are simple until you need to find, organize, and share what you wrote. I built a single-page notes app with React and React Router that handles the full note lifecycle: create, view, archive, restore, and delete. Search runs through URL query parameters, so a filtered view can be shared as a link, and a rich text editor (bold, italic, underline, lists) goes beyond the basic requirements. Input is validated with PropTypes, and dedicated routes, empty states, and a 404 page keep every path handled.",
    tags: ["React", "React Router", "Vite", "JavaScript", "PropTypes"],
    status: "React Project",
    images: ["/projek14.png", "/projek15.png", "/projek16.png"],
    demoLink: "https://personal-note-app-eta.vercel.app/",
    githubLink: "https://github.com/salsabl22/expense-tracker-app",
  },
];

/* ── Education ─────────────────────────────────────────────────────────── */
const education = [
  {
    degree: "Bachelor of Computer Science, Informatics Engineering",
    institution: "Universitas Komputer Indonesia",
    period: "2023 - 2027",
    description: "Coursework in software engineering, web development, databases, artificial intelligence, and data analytics. I apply it through team-based academic projects, including responsive web apps, AI-integrated systems, and sentiment analysis with machine learning, and through technology competitions that sharpen my analytical and problem-solving skills.",
    gpa: "3.52 / 4.0",
  },
];
