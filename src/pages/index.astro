  <script>
    /* ── Splash Screen Logic (Exact 1.5s Total Timeline) ───── */
    const splash = document.getElementById('splash-screen');
    const splashTrail = document.getElementById('splash-trail');
    const SPARKLE_CHARS = ['✦', '✧', '⋆', '·'];

    if (splash && splashTrail) {
      // Spawn pink sparkle trail following the paper plane
      let trailCount = 0;
      const trailInterval = setInterval(() => {
        if (trailCount > 10) {
          clearInterval(trailInterval);
          return;
        }
        trailCount++;
        const s = document.createElement('span');
        s.className = 'trail-sparkle';
        s.textContent = SPARKLE_CHARS[Math.floor(Math.random() * SPARKLE_CHARS.length)];
        // Trail coordinates calculated along the flight arc
        const progress = trailCount / 10;
        const xOffset = -120 + progress * 240 + (Math.random() * 20 - 10);
        const yOffset = 40 - Math.sin(progress * Math.PI) * 70 + (Math.random() * 20 - 10);
        s.style.left = `calc(50% + ${xOffset}px)`;
        s.style.top = `calc(50% + ${yOffset}px)`;
        s.style.fontSize = `${Math.floor(Math.random() * 8 + 12)}px`;
        splashTrail.appendChild(s);
        setTimeout(() => s.remove(), 800);
      }, 90);

      // 1.0s: Outro starts, 1.5s: fully removed
      setTimeout(() => {
        splash.classList.add('splash-exit');
        setTimeout(() => {
          splash.remove();
        }, 500);
      }, 1000);
    }

    /* ── Slower, Calmer Sparkle Cursor ─────────────────────── */
    const dot = document.getElementById('cursor-dot');
    let lastSparkleTime = 0;

    window.addEventListener('mousemove', (e) => {
      const { clientX: x, clientY: y } = e;
      if (dot) {
        dot.style.left = `${x}px`;
        dot.style.top = `${y}px`;
      }

      const now = Date.now();
      if (now - lastSparkleTime > 130) {
        lastSparkleTime = now;
        const s = document.createElement('span');
        s.className = 'sparkle-particle';
        s.textContent = SPARKLE_CHARS[Math.floor(Math.random() * SPARKLE_CHARS.length)];
        s.style.left = `${x}px`;
        s.style.top = `${y}px`;
        s.style.fontSize = `${Math.floor(Math.random() * 8 + 11)}px`;
        document.body.appendChild(s);
        s.addEventListener('animationend', () => s.remove(), { once: true });
      }
    });

    /* ── Theme Toggle ──────────────────────────────────────── */
    const html = document.documentElement;
    const themeBtn = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('icon-sun');
    const moonIcon = document.getElementById('icon-moon');
    const hireBtn = document.getElementById('hire-btn');

    function applyTheme(dark: boolean) {
      html.classList.toggle('dark', dark);
      sunIcon?.classList.toggle('hidden', !dark);
      moonIcon?.classList.toggle('hidden', dark);
    }

    const savedTheme = localStorage.getItem('theme');
    applyTheme(savedTheme !== 'light');

    themeBtn?.addEventListener('click', () => {
      const dark = !html.classList.contains('dark');
      applyTheme(dark);
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    });

    if (window.innerWidth >= 640 && hireBtn) {
      hireBtn.style.display = 'inline-flex';
    }

    /* ── Per-Card 3-Image Slider with Auto-Play & Buttons ───── */
    function initCardSliders() {
      const sliders = document.querySelectorAll('.card-slider');

      sliders.forEach((slider, sliderIdx) => {
        const track = slider.querySelector('.card-slider-track') as HTMLElement;
        const dots = slider.querySelectorAll('.card-slider-dot');
        const prevBtn = slider.querySelector('.card-slider-btn-prev');
        const nextBtn = slider.querySelector('.card-slider-btn-next');
        if (!track) return;

        const totalImages = track.children.length;
        let currentIdx = 0;
        let autoPlayTimer: number;

        function setSlide(i: number) {
          currentIdx = (i + totalImages) % totalImages;
          track.style.transform = `translateX(-${currentIdx * 100}%)`;
          dots.forEach((dot, dotIndex) => {
            dot.classList.toggle('active', dotIndex === currentIdx);
          });
        }

        function nextSlide() {
          setSlide(currentIdx + 1);
        }

        function prevSlide() {
          setSlide(currentIdx - 1);
        }

        function startTimer() {
          clearInterval(autoPlayTimer);
          const interval = 4200 + (sliderIdx % 3) * 600;
          autoPlayTimer = window.setInterval(nextSlide, interval);
        }

        nextBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          nextSlide();
          startTimer();
        });

        prevBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          prevSlide();
          startTimer();
        });

        dots.forEach((dot, dIdx) => {
          dot.addEventListener('click', (e) => {
            e.stopPropagation();
            setSlide(dIdx);
            startTimer();
          });
        });

        slider.addEventListener('mouseenter', () => clearInterval(autoPlayTimer));
        slider.addEventListener('mouseleave', () => startTimer());

        startTimer();
      });
    }

    initCardSliders();

    /* ── Draggable Tech Stack Marquee (Left & Right Drag) ──── */
    function initDraggableMarquees() {
      const wrappers = document.querySelectorAll('.marquee-wrapper');
      wrappers.forEach(wrapper => {
        const track = wrapper.querySelector('.marquee-track') as HTMLElement;
        if (!track) return;

        let isDown = false;
        let startX = 0;
        let startTransformX = 0;

        function getCurrentTranslateX() {
          const style = window.getComputedStyle(track);
          const matrix = new WebKitCSSMatrix(style.transform);
          return matrix.m41;
        }

        wrapper.addEventListener('mousedown', (e: MouseEvent) => {
          isDown = true;
          wrapper.classList.add('is-dragging');
          track.classList.add('is-dragging');
          const currentX = getCurrentTranslateX();
          track.style.animationPlayState = 'paused';
          track.style.transform = `translateX(${currentX}px)`;
          startX = e.pageX;
          startTransformX = currentX;
        });

        window.addEventListener('mouseup', () => {
          if (!isDown) return;
          isDown = false;
          wrapper.classList.remove('is-dragging');
          track.classList.remove('is-dragging');
          // Resume animation smoothly or maintain transform
          track.style.animationPlayState = '';
        });

        window.addEventListener('mousemove', (e: MouseEvent) => {
          if (!isDown) return;
          e.preventDefault();
          const walk = (e.pageX - startX) * 1.4;
          const newX = startTransformX + walk;
          track.style.transform = `translateX(${newX}px)`;
        });

        // Touch support for mobile/tablets
        let touchStartX = 0;
        let touchStartTransformX = 0;
        let isTouching = false;

        wrapper.addEventListener('touchstart', (e: TouchEvent) => {
          isTouching = true;
          const currentX = getCurrentTranslateX();
          track.style.animationPlayState = 'paused';
          track.style.transform = `translateX(${currentX}px)`;
          touchStartX = e.touches[0].pageX;
          touchStartTransformX = currentX;
        }, { passive: true });

        window.addEventListener('touchend', () => {
          if (!isTouching) return;
          isTouching = false;
          track.style.animationPlayState = '';
        });

        window.addEventListener('touchmove', (e: TouchEvent) => {
          if (!isTouching) return;
          const walk = (e.touches[0].pageX - touchStartX) * 1.4;
          const newX = touchStartTransformX + walk;
          track.style.transform = `translateX(${newX}px)`;
        }, { passive: true });
      });
    }

    initDraggableMarquees();

    /* ── Scroll Fade-up Observer ───────────────────────────── */
    const fadeEls = document.querySelectorAll('.fade-up');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    fadeEls.forEach(el => io.observe(el));
  </script>

</body>
</html>
